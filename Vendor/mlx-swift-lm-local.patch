+    /// Advance an existing private MTP cache over a newly appended target
+    /// suffix without replaying the complete prompt.
+    public func appendDrafterState(
+        target: any LanguageModel,
+        suffixTokens: MLXArray,
+        suffixTargetHidden: MLXArray,
+        positionDeltas _: MLXArray?,
+        state: inout MTPDrafterState,
+        sampler: any LogitSampler
+    ) {
+        guard target is Qwen35Model || target is Qwen35TextModel else {
+            fatalError("Qwen35NextNDraftModel requires a Qwen35 target")
+        }
+        let tokens = normalizedMTPTokenBatch(suffixTokens)
+        let hidden = suffixTargetHidden.ndim == 2
+            ? suffixTargetHidden.expandedDimensions(axis: 0)
+            : suffixTargetHidden
+        guard tokens.dim(-1) == hidden.dim(1) else {
+            fatalError("Qwen MTP continuation token/hidden lengths differ")
+        }
+        guard tokens.dim(-1) > 0 else { return }
+
+        state.seedToken = nil
+        state.seedHidden = nil
+        state.proposalAppended = 0
+        let (targetEmbedTokens, lmHead) = targetEmbeddingAndHead(target)
+        let inputEmbedding = mtp.embedTokens ?? targetEmbedTokens
+        let mtpHidden = mtp(
+            inputsEmbeds: inputEmbedding(tokens), hiddenStates: hidden,
+            cache: state.cache, positionOffset: state.nextPosition)
+        state.nextPosition += tokens.dim(-1)
+        state.seedHidden = mtpHidden[0..., (-1)..., 0...]
+        state.seedToken = sampleMTPSeed(
+            hidden: state.seedHidden!, targetEmbedTokens: targetEmbedTokens,
+            lmHead: lmHead, sampler: sampler)
+    }
