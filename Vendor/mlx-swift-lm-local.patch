+    /// Construct the three expert projections directly in packed form. This
+    /// avoids a floating-point initializer for very large already-quantized
+    /// MoE checkpoints.
+    public init(
+        inputDims: Int,
+        hiddenDims: Int,
+        numExperts: Int,
+        quantization: (groupSize: Int, bits: Int, mode: QuantizationMode),
+        bias: Bool = false
+    ) {
+        self.inputDims = inputDims
+        self.hiddenDims = hiddenDims
+        self.numExperts = numExperts
+        self.activation = MLXNN.silu
+        self.activationProduct = compiledSiluProduct
+
+        func make(_ input: Int, _ output: Int) -> SwitchLinear {
+            precondition(input % quantization.groupSize == 0)
+            let packed = MLXArray.zeros(
+                [numExperts, output, input * quantization.bits / 32], dtype: .uint32)
+            let scales = MLXArray.zeros(
+                [numExperts, output, input / quantization.groupSize], dtype: .bfloat16)
+            let biases = quantization.mode == .affine
+                ? MLXArray.zeros(scales.shape, dtype: .bfloat16) : nil
+            return QuantizedSwitchLinear(
+                inputDims: input,
+                outputDims: output,
+                numExperts: numExperts,
+                weight: packed,
+                scales: scales,
+                biases: biases,
+                groupSize: quantization.groupSize,
+                bits: quantization.bits,
+                mode: quantization.mode)
+        }
+
+        self._gateProj.wrappedValue = make(inputDims, hiddenDims)
+        self._upProj.wrappedValue = make(inputDims, hiddenDims)
+        self._downProj.wrappedValue = make(hiddenDims, inputDims)
+        super.init()
+    }
